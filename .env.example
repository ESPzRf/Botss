# ── Discord ───────────────────────────────────────────────────────────────────
# Токен бота: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Application ID и OAuth2-секрет нужны для входа в дашборд
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Дашборд ───────────────────────────────────────────────────────────────────
# Публичный адрес дашборда. Этот же адрес + /auth/callback нужно указать
# в Developer Portal → OAuth2 → Redirects
DASHBOARD_URL=http://localhost:8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ── База данных ───────────────────────────────────────────────────────────────
DATABASE_PATH=data/bot.db

# ── Прочее ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SESSION_TTL_DAYS=7

# Если указан, слэш-команды синхронизируются только с этим сервером (мгновенно).
# Оставьте пустым для глобальной синхронизации (может занять до часа).
DEV_GUILD_ID=
