# ── Discord ───────────────────────────────────────────────────────────────────
# Токен бота: Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Application ID и OAuth2-секрет (нужны для дашборда)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Дашборд ───────────────────────────────────────────────────────────────────
# Публичный адрес. Должен точно совпадать с redirect URI:
#   https://bot.example.com/auth/callback
DASHBOARD_URL=https://bot.example.com

# За nginx слушаем только localhost. Если nginx не используется,
# поставьте 0.0.0.0 и откройте порт (не рекомендуется без TLS).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# ── Данные ────────────────────────────────────────────────────────────────────
DATABASE_PATH=/var/lib/guardian/bot.db

# ── Прочее ────────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=7
LOG_LEVEL=INFO

# Для мгновенной синхронизации команд на тестовом сервере.
# Оставьте пустым для глобальной синхронизации.
DEV_GUILD_ID=
